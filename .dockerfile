# 1. Базовый образ
# Используем slim-версию для меньшего размера и поверхности атаки.
# Замените 3.11 на нужную вам версию Python.
FROM python:3.11-slim

# 2. Переменные окружения
# Запрещаем Python писать pyc файлы на диск (экономит место)
ENV PYTHONDONTWRITEBYTECODE=1
# Отключаем буферизацию ввода/вывода (логи будут появляться сразу)
ENV PYTHONUNBUFFERED=1

# 3. Рабочая директория
# Создаем и переходим в директорию /app внутри контейнера
WORKDIR /app

# 4. Системные зависимости (Опционально)
# Если вашему боту нужны компиляторы (gcc) или специфические системные библиотеки
# (например, для работы с БД Postgres или обработки изображений), раскомментируйте блок ниже:
# RUN apt-get update && apt-get install -y --no-install-recommends \
#   build-essential \
#   libpq-dev \
#   git \
#   && rm -rf /var/lib/apt/lists/*

# 5. Зависимости Python
# Сначала копируем только файл requirements.txt. Это позволяет Docker
# закэшировать слой с установленными библиотеками, если сам код изменился,
# а requirements.txt — нет.
COPY requirements.txt .

# Обновляем pip и устанавливаем зависимости.
# --no-cache-dir предотвращает сохранение кэша пакетов pip в образе.
RUN pip install --upgrade pip && \
  pip install --no-cache-dir -r requirements.txt

# 6. Копирование кода
# Копируем весь остальной исходный код проекта в рабочую директорию.
COPY . .

# 7. Безопасность (Настоятельно рекомендуется)
# Создаем пользователя 'botuser' без прав root и передаем ему владение папкой /app.
RUN useradd -m -u 1000 botuser && \
  chown -R botuser:botuser /app
# Переключаемся на этого пользователя.
USER botuser

# 8. Команда запуска
# Указываем команду, которая запустит вашего бота.
# Замените 'main.py' на имя вашего главного исполняемого файла.
CMD ["python", "bot.py"]
